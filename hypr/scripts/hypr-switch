#!/usr/bin/env bash
# SUPER+Space switcher/launcher — a fuzzel --dmenu merged list of:
#   1. open WINDOWS      -> focus (jumps to its workspace/monitor too)
#   2. WORKSPACES        -> focus
#   3. favorite APPS     -> spawn
#   4. "All apps…"       -> reopen fuzzel in full drun mode (escape hatch)
#
# Replaces the plain `fuzzel` drun that used to be on SUPER+Space. One tool,
# one key, Wayland-native — the switch targets you actually use up front,
# instead of the entire app catalog.
#
# HOW IT STAYS ROBUST
#   fuzzel is fed only display LABELS; `--index` returns the chosen line number,
#   which we map back to a parallel ACTIONS array. Nothing parses display text.
#
# HYPRLAND DISPATCH NOTE (same gotcha as hypr-move / hypr-rename)
#   This Hyprland is configured in Lua, so `hyprctl dispatch <name> …` is parsed
#   AS Lua and fails. Dispatchers must go through the wrapper:
#       hyprctl eval 'hl.dispatch(hl.dsp.<path>({ … }))'
#   Focus window:    hl.dsp.focus({ window = "address:0x…" })
#   Focus workspace: hl.dsp.focus({ workspace = <id> | "name:<name>" })
#   Apps are launched directly (setsid -f); Hyprland window-rules still apply
#   (they match on class, not on how the process was spawned).
#
# FOLLOW_MOUSE GOTCHA
#   input:follow_mouse=1 here, so a bare focus-window dispatch gets stolen back
#   to whatever sits under the cursor. We therefore focus the window AND warp
#   the cursor onto its centre in a SINGLE atomic eval (hl.dsp.cursor.move), so
#   no cursor-driven re-focus can sneak in between the two dispatches.

set -euo pipefail

# ── favorite apps: "command<TAB>Label<TAB>open-token" ───────────────────────
# Edit this list to taste. Command is run verbatim via `sh -c`.
# open-token: a lowercase substring of the window class this app opens. If a
# matching window is ALREADY open, the launch entry is suppressed — so typing
# e.g. "slack" resolves to the running Slack window/workspace (switch) instead
# of a competing "launch Slack" entry (which, since Slack's already running,
# would do nothing). Launch entries are for apps that aren't open yet.
apps=(
  $'slack\tSlack\tslack'
  $'google-chrome-stable --ozone-platform=wayland --enable-features=WaylandLinuxDrmSyncobj\tChrome\tchrome'
  $'Telegram\tTelegram\ttelegram'
  $'bolt\tBolt\tbolt'
  $'runelite\tOSRS\trunelite'
  $'obsidian\tObsidian\tobsidian'
)

# ── build parallel actions[] / labels[] ─────────────────────────────────────
# Each source emits rows of "ACTION<TAB>LABEL"; ACTION is "kind|payload".
actions=()
labels=()

add_rows() {  # reads "ACTION<TAB>LABEL" lines on stdin
  local row
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    actions+=( "${row%%$'\t'*}" )
    labels+=( "${row#*$'\t'}" )
  done
}

# 1. Windows — mapped, non-hidden, non-special.
#    Action carries the window centre (at + size/2) so we can warp onto it.
#    Label: "class — title".
add_rows < <(hyprctl clients -j | jq -r '
  [ .[]
    | select(.mapped and (.hidden | not))
    | select((.workspace.name // "") | startswith("special:") | not) ]
  | sort_by(.class, .title)
  | .[]
  | "win|address:\(.address)|\((.at[0] + .size[0] / 2) | floor)|\((.at[1] + .size[1] / 2) | floor)\t\(.class) — \(.title[0:70])"
')

# 2. Workspaces — non-special. Positive id -> focus by id; named (neg id) -> by name.
add_rows < <(hyprctl workspaces -j | jq -r '
  [ .[] | select((.name // "") | startswith("special:") | not) ]
  | sort_by(.id)
  | .[]
  | (if .id > 0 then "ws|\(.id)" else "ws|name:\(.name)" end)
    + "\t→ \(.name)  ·  ws"
')

# 3. Favourite apps — suppress any whose window is already open (switch, don't spawn)
open_classes=$(hyprctl clients -j | jq -r '.[].class' | tr '[:upper:]' '[:lower:]')
for a in "${apps[@]}"; do
  IFS=$'\t' read -r cmd label token <<<"$a"
  grep -qF "$token" <<<"$open_classes" && continue   # already open -> use its window/ws entry
  actions+=( "app|$cmd" )
  labels+=( "$label" )
done

# 4. Escape hatch: full app catalog
actions+=( "drun|" )
labels+=( "All apps…" )

# ── pick ────────────────────────────────────────────────────────────────────
# Category icon (a coloured dot) per row via fuzzel's dmenu icon protocol
# (label\0icon\x1fpath): windows=blue, workspaces=green, apps=peach, more=grey.
# Bash can't hold a NUL in a variable, so each line is assembled with printf at
# feed time, keyed off the action's kind.
ICON_DIR="$HOME/.dotfiles/fuzzel/swatches"
feed() {
  local i ic
  for i in "${!labels[@]}"; do
    case "${actions[$i]%%|*}" in
      win) ic="$ICON_DIR/window.png" ;;
      ws)  ic="$ICON_DIR/workspace.png" ;;
      app) ic="$ICON_DIR/app.png" ;;
      *)   ic="$ICON_DIR/more.png" ;;
    esac
    printf '%s\0icon\x1f%s\n' "${labels[$i]}" "$ic"
  done
}

# Testing seam: HYPR_SWITCH_DUMP=1 prints plain labels; =icons emits the real
# fuzzel feed (label + per-row icon) so a throwaway fuzzel can preview the look.
if [ -n "${HYPR_SWITCH_DUMP:-}" ]; then
  if [ "$HYPR_SWITCH_DUMP" = icons ]; then feed; else printf '%s\n' "${labels[@]}"; fi
  exit 0
fi

idx=$(feed | fuzzel --dmenu --index --prompt 'go › ' || true)
[[ "$idx" =~ ^[0-9]+$ ]] && [ "$idx" -lt "${#actions[@]}" ] || exit 0

sel="${actions[$idx]}"
kind="${sel%%|*}"
payload="${sel#*|}"

# Build the focus dispatch (win/ws) as a Lua string; launch directly (app/drun).
lua=""
case "$kind" in
  win)
    # payload = "address:0x…|cx|cy" — focus the window AND warp the cursor onto
    # its centre (FOLLOW_MOUSE GOTCHA). Deferred below so fuzzel can't steal it.
    IFS='|' read -r waddr wcx wcy <<<"$payload"
    lua="hl.dispatch(hl.dsp.focus({ window = \"$waddr\" })); hl.dispatch(hl.dsp.cursor.move({ x = $wcx, y = $wcy }))"
    ;;
  ws)
    if [[ "$payload" =~ ^[0-9]+$ ]]; then wsval="$payload"; else wsval="\"$payload\""; fi
    lua="hl.dispatch(hl.dsp.focus({ workspace = $wsval }))"
    ;;
  app)
    setsid -f sh -c "$payload" >/dev/null 2>&1
    ;;
  drun)
    setsid -f fuzzel >/dev/null 2>&1
    ;;
esac

# FUZZEL TEARDOWN RACE (the "display switched but focus didn't" bug):
# When fuzzel closes it releases its keyboard grab and Hyprland returns focus to
# the previously-focused window. A single immediate focus dispatch loses that
# race — the async focus-return fires just after us and snaps focus back home
# (the workspace visibly switches, but the keyboard stays put). Fix: run the
# dispatch DETACHED (so the script/fuzzel fully exit first) and re-assert it a
# few times over ~150ms so a dispatch always lands AFTER the teardown and wins.
# The Lua is passed as an argv element ($1) to sidestep nested-quoting.
if [ -n "$lua" ]; then
  setsid -f bash -c 'for _ in 1 2 3; do hyprctl eval "$1" >/dev/null 2>&1; sleep 0.06; done' _ "$lua"
fi
