#!/usr/bin/env bash
# Name the CURRENT Hyprland workspace via a rofi prompt.
# Wayland port of ~/.dotfiles/i3/scripts/i3-rename, extended so that giving a
# NUMBERED workspace a WORD name turns it into a *pure named* workspace
# (no numeric id) instead of a renamed-numbered one that still squats the numeric
# slot — a renamed-in-place ws keeps its id, so `SUPER+SHIFT+<n>` / typing that
# number would still land on it. Converting frees the slot for real numbered use.
# Bound to SUPER+SHIFT+A in ~/.dotfiles/hypr/hyprland.lua.
#
# Behaviour:
#   word name (numbered OR named ws) -> CONVERT: move its windows onto name:<x>
#       (a fresh workspace) and follow. A numbered ws frees its slot.
#       name:<x> is created on the focused monitor — which, since we act on the
#       ACTIVE workspace, is that workspace's own monitor — so it stays put.
#   numeric name, or the name the ws was created with -> plain in-place rename.
#
# Hyprland 0.57 (2026-10-30): a named workspace has no id in -j output. A
# name:<x> selector matches the workspace's `address`: the name it started
# with. An in-place rename keeps the old address, so name:<new> finds nothing
# and hypr-switch / hypr-move create an empty duplicate. Converting keeps
# address == name. The script still targets a numbered ws by its id.
#
# NOTE: this Hyprland is Lua-configured, so dispatchers go through
#   hyprctl eval 'hl.dispatch(hl.dsp.<path>({ ... }))'  (NOT `hyprctl dispatch`),
#   a named target must be name:<x>, and zsh doesn't word-split — iterate window
#   addresses with `while read`.

name=$(printf '' | rofi -dmenu -p "Name workspace: ")
[ $? -eq 0 ] && [ -n "$name" ] || exit 0

ws=$(hyprctl activeworkspace -j)
id=$(jq -r '.id // empty' <<<"$ws")          # numbered workspaces only
addr=$(jq -r '.address // empty' <<<"$ws")   # what a name:<x> selector matches
[ -n "$addr" ] || exit 0

# Escape for a Lua double-quoted string literal.
lua_esc() { local s=${1//\\/\\\\}; printf '%s' "${s//\"/\\\"}"; }
esc=$(lua_esc "$name")

if [[ "$name" =~ ^[0-9]+$ ]] || [ "$name" = "$addr" ]; then
    # Numeric label, or back to the name it was created with -> relabel in place.
    if [ -n "$id" ]; then sel=$id; else sel="\"name:$(lua_esc "$addr")\""; fi
    hyprctl eval "hl.dispatch(hl.dsp.workspace.rename({ workspace = $sel, name = \"$esc\" }))"
else
    # Word name -> move every window onto a fresh name:<name> workspace and follow.
    hyprctl clients -j \
        | jq -r --arg w "$addr" '.[] | select(.workspace.address == $w) | .address' \
        | while IFS= read -r a; do
            [ -n "$a" ] || continue
            hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = \"name:$esc\", follow = false, window = \"address:$a\" }))"
        done
    hyprctl eval "hl.dispatch(hl.dsp.focus({ workspace = \"name:$esc\" }))"
fi
