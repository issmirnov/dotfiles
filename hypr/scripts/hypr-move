#!/usr/bin/env bash
# Move the CURRENTLY focused window to a workspace chosen/typed in rofi.
# Wayland port of ~/.dotfiles/i3/scripts/i3-move
#   (i3 did: i3-msg "move window to workspace $name").
# Bound to SUPER+SHIFT+S in ~/.dotfiles/hypr/hyprland.lua.
#
# Existing workspaces are offered (special: workspaces excluded); you can also
# type a new name to create-and-move in one step.
#   - a purely numeric entry -> that numbered workspace (e.g. 3)
#   - anything else          -> a NAMED workspace
# Always moves silently and stays put (i3-move behaviour; same as the
# SUPER+SHIFT+[0-9] binds). A brand-new workspace is created and the window
# sent there without following, so focus never leaves the current workspace.
#
# Lua-configured Hyprland: dispatch via `hyprctl eval 'hl.dispatch(hl.dsp...)'`
# rather than `hyprctl dispatch ...` (see hypr-rename for the why).

wsjson=$(hyprctl workspaces -j)

name=$(printf '%s' "$wsjson" \
        | jq -r '.[] | select(.name | startswith("special:") | not) | .name' \
        | sort -n \
        | rofi -dmenu -i -p "Move window to workspace: ")
[ $? -eq 0 ] && [ -n "$name" ] || exit 0

if [[ "$name" =~ ^[0-9]+$ ]]; then
    ws="$name"                                    # numbered workspace: bare number
else
    esc=${name//\\/\\\\}; esc=${esc//\"/\\\"}
    ws="\"name:$esc\""                            # named workspace: MUST use name: prefix,
                                                  # else Hyprland errors "Invalid workspace"
                                                  # when the target doesn't exist yet
fi
# Always a silent move — never follow, even for a freshly created workspace.
hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = $ws, follow = false }))"
