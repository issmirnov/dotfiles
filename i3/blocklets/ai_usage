#!/usr/bin/env bash
# i3blocks: Claude Code / Codex usage (5h + weekly), verbose with reset countdowns.
# Provider via $BLOCK_INSTANCE (claude|codex).
#   claude -> better-ccflare fleet (all Anthropic accounts) via $CCFLARE_BASE/api/accounts;
#            Bearer token read at runtime from ~/.config/ccflare/token (untracked, NOT in repo).
#   codex  -> ChatGPT usage via the ~/.codex OAuth token read from $HOME.
# No secrets are stored in this file — safe to commit to a public repo.
set -u
CACHE_DIR="${AIUSAGE_CACHE_DIR:-$HOME/.cache/i3blocks-aiusage}"

pct_color() {
  local p=${1:-0}
  if   [ "$p" -ge 90 ]; then echo "#FF1744"
  elif [ "$p" -ge 70 ]; then echo "#FFD600"
  else                       echo "#00C853"
  fi
}

fmt_reset() {
  local s=${1:-0} d h m
  d=$(( s / 86400 )); h=$(( (s % 86400) / 3600 )); m=$(( (s % 3600) / 60 ))
  if   [ "$d" -gt 0 ]; then echo "${d}d${h}h"
  elif [ "$h" -gt 0 ]; then echo "${h}h${m}m"
  else
    if [ "$m" -gt 0 ]; then echo "${m}m"; else echo "<1m"; fi
  fi
}

# Pace toward 100% over a usage window (the weekly limit). Compares actual usage to
# where even (1/7-per-day) pacing would put you now, returning an emoji + the points
# off pace: ⚠️N = N ahead (burning hot — ease off or you'll run out early), 🦥N = N
# behind (under-using — speed up), ✅ = on pace (within ±tol). Empty when no reset time.
# Args: used remaining_seconds window_seconds
pace_sym() {
  local used=$1 rem=$2 window=$3 elapsed expected delta tol=5
  [ -z "$rem" ] && return 0
  [ "$rem" -lt 0 ] && rem=0; [ "$rem" -gt "$window" ] && rem=$window
  elapsed=$(( window - rem ))
  expected=$(( elapsed * 100 / window ))
  delta=$(( used - expected ))
  if   [ "$delta" -gt "$tol" ];  then echo "⚠️${delta}"
  elif [ "$delta" -lt "-$tol" ]; then echo "🦥$(( -delta ))"
  else echo "✅"
  fi
}

# Short 2-char tag for an account name. Known accounts get a stable hand-picked
# tag (matching the Home Assistant sensor naming); anything else derives one by
# stripping a leading "claude"/separator and taking the first two alnum chars.
short_tag() {
  local n="${1:-}"
  case "$n" in
    *smirnovlabs*) echo "sl" ;;
    *isgmirnov*)   echo "ig" ;;
    *) n=$(printf '%s' "$n" | sed -E 's/^claude[-_]?//; s/[^a-zA-Z0-9]//g'); echo "${n:0:2}" ;;
  esac
}

# Render the whole better-ccflare Anthropic fleet: one "<tag> 5h/7d" segment per
# account, worst-utilization account first, with a weekly pace token and (when a
# window is >=50%) a reset countdown. Block color + short_text track the single
# worst window across all accounts. Input: raw /api/accounts JSON (array).
render_claude() {
  local json=$1 now name five sev sev_ts five_ts worst tag seg sres rem pace wts wres r gmax=-1
  local -a segs=()
  now=$(date +%s)
  while IFS=$'\t' read -r name five sev sev_ts five_ts; do
    [ -z "$name" ] && continue
    five=${five%.*}; sev=${sev%.*}; five=${five:-0}; sev=${sev:-0}
    tag=$(short_tag "$name")
    worst=$five; [ "$sev" -gt "$worst" ] && worst=$sev
    seg="$tag ${five}/${sev}"
    if [ -n "$sev_ts" ] && [ "$sev_ts" != "null" ]; then
      sres=$(date -d "$sev_ts" +%s 2>/dev/null)
      if [ -n "$sres" ]; then
        rem=$(( sres - now )); pace=$(pace_sym "$sev" "$rem" 604800)
        [ -n "$pace" ] && seg="$seg $pace"
      fi
    fi
    if [ "$worst" -ge 50 ]; then
      if [ "$five" -ge "$sev" ]; then wts=$five_ts; else wts=$sev_ts; fi
      if [ -n "$wts" ] && [ "$wts" != "null" ]; then
        wres=$(date -d "$wts" +%s 2>/dev/null)
        [ -n "$wres" ] && { r=$(( wres - now )); [ "$r" -gt 0 ] && seg="$seg ($(fmt_reset "$r"))"; }
      fi
    fi
    segs+=("$seg")
    [ "$worst" -gt "$gmax" ] && gmax=$worst
  done < <(jq -r --arg acct "$ACCT" '
      [ .[] | select(.provider=="anthropic") | select($acct=="" or .name==$acct) ]
      | sort_by( [ (.usageData.five_hour.utilization // 0), (.usageData.seven_day.utilization // 0) ] | max )
      | reverse | .[]
      | [ .name,
          (.usageData.five_hour.utilization // 0),
          (.usageData.seven_day.utilization // 0),
          (.usageData.seven_day.resets_at // ""),
          (.usageData.five_hour.resets_at // "") ] | @tsv
    ' <<<"$json" 2>/dev/null)
  [ "$gmax" -lt 0 ] && return 1
  local full="CC ${segs[0]}" i
  for ((i = 1; i < ${#segs[@]}; i++)); do full="$full  ${segs[i]}"; done
  printf '%s\n%s\n%s\n' "$full" "CC ${gmax}%" "$(pct_color "$gmax")"
}
# Render whichever usage windows the codex API actually exposes (it may return only one,
# e.g. a weekly window with secondary=null — don't demand both or the chip shows "?").
# Each window is labeled by its real limit_window_seconds when present (5h / wk / Nh),
# else positionally (primary=5h, secondary=wk) to preserve the older window-less shape.
# Weekly windows get a pace token; a window >=50% adds a reset countdown. Color/short_text
# track the worst window. Returns 1 only when NO window has data.
render_codex() {
  local json=$1 win pos pct rs w lbl seg pace weekly gmax=-1
  local -a segs=() pcts=()
  pos=0
  for win in primary_window secondary_window; do
    pos=$(( pos + 1 ))
    pct=$(jq -r ".rate_limit.$win.used_percent // empty"        <<<"$json" 2>/dev/null); pct=${pct%.*}
    [ -z "$pct" ] && continue
    rs=$(jq -r  ".rate_limit.$win.reset_after_seconds // -1"    <<<"$json" 2>/dev/null); rs=${rs%.*}; rs=${rs:--1}
    w=$(jq -r   ".rate_limit.$win.limit_window_seconds // empty" <<<"$json" 2>/dev/null); w=${w%.*}
    if [ -n "$w" ]; then
      if   [ "$w" -le 18000 ];  then lbl="5h"; weekly=0
      elif [ "$w" -ge 518400 ]; then lbl="wk"; weekly=1
      else lbl="$(( w / 3600 ))h"; weekly=0; fi
    else
      if [ "$pos" -eq 1 ]; then lbl="5h"; weekly=0; else lbl="wk"; weekly=1; fi
      w=604800
    fi
    seg="$lbl ${pct}%"
    if [ "$weekly" -eq 1 ] && [ "$rs" -ge 0 ]; then
      pace=$(pace_sym "$pct" "$rs" "$w"); [ -n "$pace" ] && seg="$seg $pace"
    fi
    [ "$pct" -ge 50 ] && [ "$rs" -gt 0 ] && seg="$seg ($(fmt_reset "$rs"))"
    segs+=("$seg"); pcts+=("$pct")
    [ "$pct" -gt "$gmax" ] && gmax=$pct
  done
  [ "$gmax" -lt 0 ] && return 1
  local full="CX ${segs[0]}" short="CX ${pcts[0]}" i
  for ((i = 1; i < ${#segs[@]}; i++)); do full="$full ${segs[i]}"; short="$short/${pcts[i]}"; done
  printf '%s\n%s\n%s\n' "$full" "$short" "$(pct_color "$gmax")"
}
# Raw provider JSON for the detail popups: fresh cache, else fetch (cache on success),
# else stale cache. Same acquisition as main() but returns the JSON instead of rendering.
load_json() {
  local ttl cache mtime json
  case "$PROVIDER" in codex) ttl=120;; *) ttl=180;; esac
  mkdir -p "$CACHE_DIR"; cache="$CACHE_DIR/$PROVIDER.json"
  mtime=$(stat -c %Y "$cache" 2>/dev/null)
  if [ -n "$mtime" ] && [ $(( $(date +%s) - mtime )) -lt "$ttl" ]; then cat "$cache"; return 0; fi
  json=$("fetch_$PROVIDER")
  if "validate_$PROVIDER" "$json"; then printf '%s' "$json" > "$cache"; printf '%s' "$json"; return 0; fi
  if [ "$PROVIDER" = "codex" ] && json=$(codex_rollout_json) && [ -n "$json" ]; then printf '%s' "$json"; return 0; fi
  [ -f "$cache" ] && { cat "$cache"; return 0; }
  return 1
}

# Seconds until an ISO timestamp resets (echo -1 when absent/null/past). $1 = timestamp.
reset_secs() {
  local ts=${1:-} now e
  { [ -z "$ts" ] || [ "$ts" = "null" ]; } && { echo -1; return; }
  e=$(date -d "$ts" +%s 2>/dev/null) || { echo -1; return; }
  now=$(date +%s); e=$(( e - now )); [ "$e" -lt 0 ] && e=-1; echo "$e"
}

# Popup detail JSON for ONE Anthropic account: its 5h + weekly windows. Input: ccflare JSON.
# Shape: {title, windows:[{label,pct,reset_s,pace}, ...]}
detail_claude() {
  local json=$1 name five sev five_ts sev_ts tag fs ws pace
  # NOTE: emit "null" (not "") for missing timestamps below. Tab is IFS-whitespace, so a
  # `read` over @tsv COLLAPSES consecutive tabs and drops empty middle fields — an empty
  # five_ts would slide the weekly timestamp into the 5h slot. reset_secs maps "null"->-1.
  IFS=$'\t' read -r name five sev five_ts sev_ts < <(jq -r --arg acct "$ACCT" '
      [ .[] | select(.provider=="anthropic") | select($acct=="" or .name==$acct) ]
      | sort_by( [ (.usageData.five_hour.utilization // 0), (.usageData.seven_day.utilization // 0) ] | max )
      | reverse | .[0]
      | [ .name,
          (.usageData.five_hour.utilization // 0),
          (.usageData.seven_day.utilization // 0),
          (.usageData.five_hour.resets_at // "null"),
          (.usageData.seven_day.resets_at // "null") ] | @tsv' <<<"$json" 2>/dev/null)
  [ -z "$name" ] && return 1
  five=${five%.*}; sev=${sev%.*}; five=${five:-0}; sev=${sev:-0}
  tag=$(short_tag "$name")
  fs=$(reset_secs "$five_ts"); ws=$(reset_secs "$sev_ts")
  pace=""; [ "$ws" -ge 0 ] && pace=$(pace_sym "$sev" "$ws" 604800)
  jq -cn --arg title "CC $tag · ${name#claude[-_]}" \
     --argjson five "$five" --argjson fs "$fs" \
     --argjson wk "$sev" --argjson ws "$ws" --arg pace "$pace" '
     {title:$title,
      windows:[ {label:"5h", pct:$five, reset_s:$fs, pace:""},
                {label:"7d", pct:$wk,   reset_s:$ws, pace:$pace} ]}'
}

# Popup detail JSON for codex: whatever usage windows the API exposes, labeled by window
# size (<=5h, weekly, else Nh). Skips null windows; pace only on the weekly window.
detail_codex() {
  local json=$1 wins="[]" win pct rs w lbl pace
  for win in primary_window secondary_window; do
    pct=$(jq -r ".rate_limit.$win.used_percent // empty" <<<"$json" 2>/dev/null); pct=${pct%.*}
    [ -z "$pct" ] && continue
    rs=$(jq -r ".rate_limit.$win.reset_after_seconds // -1"    <<<"$json" 2>/dev/null); rs=${rs%.*}; rs=${rs:--1}
    w=$(jq -r  ".rate_limit.$win.limit_window_seconds // 604800" <<<"$json" 2>/dev/null); w=${w%.*};  w=${w:-604800}
    if   [ "$w" -le 18000 ];  then lbl="5h"
    elif [ "$w" -ge 518400 ]; then lbl="wk"
    else lbl="$(( w / 3600 ))h"; fi
    pace=""; [ "$w" -ge 518400 ] && [ "$rs" -ge 0 ] && pace=$(pace_sym "$pct" "$rs" "$w")
    wins=$(jq -c --argjson pct "$pct" --argjson rs "$rs" --arg lbl "$lbl" --arg pace "$pace" \
      '. + [{label:$lbl, pct:$pct, reset_s:$rs, pace:$pace}]' <<<"$wins")
  done
  [ "$wins" = "[]" ] && return 1
  jq -cn --argjson wins "$wins" '{title:"Codex", windows:$wins}'
}

main() {
  local provider="$PROVIDER" ttl cache json
  case "$provider" in codex) ttl=120;; *) ttl=180;; esac
  mkdir -p "$CACHE_DIR"; cache="$CACHE_DIR/$provider.json"

  # 1) fresh cache -> live color
  local mtime; mtime=$(stat -c %Y "$cache" 2>/dev/null)
  if [ -n "$mtime" ] && [ $(( $(date +%s) - mtime )) -lt "$ttl" ]; then
    "render_$provider" "$(cat "$cache")" && return 0
  fi
  # 2) fetch live; cache only on valid response
  json=$("fetch_$provider")
  if "validate_$provider" "$json"; then
    printf '%s' "$json" > "$cache"
    "render_$provider" "$json" && return 0
  fi
  # 3) fallbacks, rendered gray
  if [ "$provider" = "codex" ] && json=$(codex_rollout_json) && [ -n "$json" ]; then
    emit_dim "$json" && return 0
  fi
  if [ -f "$cache" ]; then emit_dim "$(cat "$cache")" && return 0; fi
  # 4) nothing available
  local l; l=$(label); printf '%s ?\n%s ?\n#888888\n' "$l" "$l"
}

fetch_claude() {
  [ -n "${AIUSAGE_NO_FETCH:-}" ] && return 1
  local tokfile="${CCFLARE_TOKEN_FILE:-$HOME/.config/ccflare/token}" base token
  base="${CCFLARE_BASE:-http://10.3.39.6:8080}"
  token=$(head -n1 "$tokfile" 2>/dev/null | tr -d '[:space:]'); [ -z "$token" ] && return 1
  curl -sS --max-time 6 -H "Authorization: Bearer $token" "$base/api/accounts" 2>/dev/null
}
# Valid iff the array has at least one Anthropic account exposing a 5h utilization.
validate_claude() { jq -e 'any(.[]?; .provider=="anthropic" and (.usageData.five_hour.utilization != null))' >/dev/null 2>&1 <<<"${1:-}"; }

fetch_codex() {
  [ -n "${AIUSAGE_NO_FETCH:-}" ] && return 1
  local auth="$HOME/.codex/auth.json" token acct
  [ -f "$auth" ] || return 1
  token=$(jq -r '.tokens.access_token // empty' "$auth"); [ -z "$token" ] && return 1
  acct=$(jq -r '.tokens.account_id // empty' "$auth")
  curl -sS --max-time 6 \
    -H "Authorization: Bearer $token" \
    -H "ChatGPT-Account-Id: $acct" \
    -H "User-Agent: codex-cli" \
    "https://chatgpt.com/backend-api/wham/usage" 2>/dev/null
}
validate_codex() { jq -e '.rate_limit.primary_window.used_percent' >/dev/null 2>&1 <<<"${1:-}"; }

# stdin: one rollout JSONL line -> stdout: wham-shaped JSON (or exit 1)
map_rollout_line() {
  jq -e -c '
    .payload.rate_limits as $r
    | select($r != null and $r.primary != null)
    | def after($w): (if $w.resets_at then ($w.resets_at - now)
                      elif $w.resets_in_seconds then $w.resets_in_seconds
                      else 0 end | floor);
      { rate_limit: {
          primary_window:   { used_percent: $r.primary.used_percent,   reset_after_seconds: after($r.primary) },
          secondary_window: { used_percent: $r.secondary.used_percent, reset_after_seconds: after($r.secondary) } } }
  ' 2>/dev/null
}

codex_rollout_json() {
  local f line
  if [ -n "${AIUSAGE_ROLLOUT_FILE:-}" ]; then
    f="$AIUSAGE_ROLLOUT_FILE"
  else
    f=$(ls -t "$HOME"/.codex/sessions/*/*/*/rollout-*.jsonl 2>/dev/null | head -1)
  fi
  [ -n "$f" ] || return 1
  line=$(grep '"rate_limits"' "$f" 2>/dev/null | tail -1); [ -n "$line" ] || return 1
  printf '%s' "$line" | map_rollout_line
}

label() { case "$PROVIDER" in codex) echo "CX";; *) echo "CC";; esac; }

# re-render the given JSON but force the color line to gray (stale/fallback marker)
emit_dim() {
  local out l1 l2; out=$("render_$PROVIDER" "$1") || return 1
  { IFS= read -r l1; IFS= read -r l2; } <<<"$out"
  printf '%s\n%s\n#888888\n' "$l1" "$l2"
}

# ---- instance parse: BLOCK_INSTANCE is "provider[:account]" ----
# A bare "claude"/"codex" renders the whole provider; "claude:<account-name>"
# renders just that ccflare account so it gets its own i3 block and its own color.
PROVIDER="${BLOCK_INSTANCE:-claude}"; ACCT=""
case "$PROVIDER" in *:*) ACCT="${PROVIDER#*:}"; PROVIDER="${PROVIDER%%:*}" ;; esac

# ---- dispatch ----
case "${1:-}" in
  __color)  pct_color "${2:-0}"; exit 0 ;;
  __reset)  fmt_reset "${2:-0}"; exit 0 ;;
  __tag)    short_tag "${2:-}"; exit 0 ;;
  __pace)   pace_sym "${2:-}" "${3:-}" "${4:-604800}"; exit 0 ;;
  __render)     "render_$PROVIDER" "$(cat)"; exit $? ;;
  __detail)     if json=$(load_json) && out=$("detail_$PROVIDER" "$json"); then printf '%s\n' "$out"
                else printf '{"title":"%s","windows":[]}\n' "$(label)"; fi; exit 0 ;;
  __maprollout) map_rollout_line; exit $? ;;
  *)        main ;;
esac
