#!/usr/bin/env bash
# claude_peak: i3blocks segment for Claude peak hours, shown by quickshell/Bar.qml.
# The window and the chip's text live in bin/claude-peak (see its header); this file
# keeps the path the bar runs. Always exits 0.
"$(dirname "$(readlink -f "$0")")/../../bin/claude-peak" --i3blocks
exit 0
