[Unit]
Description=tmux server (detached; sessions restored by tmux-resurrect at boot)
Documentation=man:tmux(1)

[Service]
Type=oneshot
RemainAfterExit=yes
# 1) start the bare server (no session -> no collision; exit-empty off in
#    tmux.conf keeps it alive). 2) restore SYNCHRONOUSLY via resurrect's own
#    restore.sh, run through `tmux run-shell` so $TMUX is set and the socket
#    resolves -- the exact path the `prefix + Ctrl-r` keybinding uses. This
#    replaces continuum's backgrounded auto-restore, which races at cold boot
#    (sleep 1 + "another tmux server" process-count guard). The leading `-`
#    makes systemd ignore restore.sh's noisy non-zero exit.
ExecStart=/usr/bin/tmux start-server
ExecStartPost=-/usr/bin/tmux run-shell /home/vania/.dotfiles/tmux/plugins/tmux-resurrect/scripts/restore.sh
ExecStop=/usr/bin/tmux kill-server

[Install]
WantedBy=default.target
