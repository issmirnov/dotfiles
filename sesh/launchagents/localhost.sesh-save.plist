<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>localhost.sesh-save</string>

  <!-- launchd expands neither ~ nor $HOME, so a shell resolves this user's
       paths and owns the log redirect (the state dir may not exist yet). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>mkdir -p "$HOME/.local/state/sesh" &amp;&amp; exec "$HOME/.dotfiles/sesh/sesh-save" 2&gt;&gt;"$HOME/.local/state/sesh/save.err.log"</string>
  </array>

  <!-- Snapshot the live session set every 2 min. Deliberately NO RunAtLoad: the
       early-boot guard in sesh-save would skip a login run anyway, and we must
       not clobber the pre-shutdown snapshot before sesh-restore reads it. -->
  <key>StartInterval</key>
  <integer>120</integer>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
