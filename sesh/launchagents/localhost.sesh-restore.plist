<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>localhost.sesh-restore</string>

  <!-- launchd expands neither ~ nor $HOME, so a shell resolves this user's
       paths and owns the log redirect (the state dir may not exist yet). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>mkdir -p "$HOME/.local/state/sesh" &amp;&amp; exec "$HOME/.dotfiles/sesh/sesh-restore" &gt;&gt;"$HOME/.local/state/sesh/restore.log" 2&gt;&amp;1</string>
  </array>

  <!-- Rebuild the last snapshot at login (reboot / shutdown / crash recovery).
       Not a daemon; sesh-restore itself waits for hexane before remote opens. -->
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
