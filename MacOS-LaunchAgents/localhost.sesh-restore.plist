<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>localhost.sesh-restore</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/vania/.dotfiles/bin/sesh-restore</string>
  </array>

  <!-- Rebuild the last snapshot at login (reboot / shutdown / crash recovery).
       Not a daemon; sesh-restore itself waits for hexane before remote opens. -->
  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/vania/.local/state/sesh/restore.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/vania/.local/state/sesh/restore.log</string>
</dict>
</plist>
